<Window x:Class="Coh3Trainer.InformationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:localization="clr-namespace:Coh3Trainer.Localization"
        Title="{Binding [App.Title], Source={x:Static localization:LocalizationService.Current}}"
        Icon="Assets/trainer.ico"
        Width="480" SizeToContent="Height" MaxHeight="620"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBackground}"
        Foreground="{StaticResource TextPrimary}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="SectionText" Grid.Row="0"
                   FontSize="12" FontWeight="SemiBold"
                   Foreground="{StaticResource SecondaryText}" />
        <TextBlock x:Name="HeadingText" Grid.Row="1" Margin="0,6,0,12"
                   FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" />
        <Border Grid.Row="2" Background="{StaticResource PanelBackground}"
                BorderBrush="{StaticResource PanelBorder}" BorderThickness="1"
                CornerRadius="6" Padding="16">
            <TextBlock x:Name="BodyText" FontSize="15" LineHeight="23"
                       TextWrapping="Wrap" />
        </Border>
        <Button Grid.Row="3" Width="110" Margin="0,18,0,0"
                HorizontalAlignment="Right" IsDefault="True" IsCancel="True"
                Click="CloseButton_Click"
                Content="{Binding [Action.Close], Source={x:Static localization:LocalizationService.Current}}" />
    </Grid>
</Window>
