<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>Coh3Trainer</AssemblyName>
    <RootNamespace>Coh3Trainer</RootNamespace>
    <Version>1.0.0</Version>
    <AssemblyTitle>CoH3 Resource Trainer</AssemblyTitle>
    <Authors>LordSteelHand</Authors>
    <Product>CoH3 Resource Trainer</Product>
    <Description>Local resource trainer for Company of Heroes 3 campaign and private AI matches.</Description>
    <ApplicationIcon>..\..\assets\branding\trainer.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="..\..\assets\branding\trainer.ico"
              Link="Assets\trainer.ico" />
    <Resource Include="..\..\assets\branding\trainer-icon-master.png"
              Link="Assets\trainer-icon-master.png" />
    <None Include="..\..\profiles\*.json"
          Link="profiles\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="Never" />
  </ItemGroup>
</Project>
